// See https://zed.dev/docs/tasks for documentation.
[
  {
    "label": "CMake: Config Debug (Clang/Ninja)",
    "command": "cmake",
    "args": [
      "-G",
      "Ninja",
      "-B",
      "build",
      "-S",
      ".",
      "-DCMAKE_CXX_COMPILER=clang++",
      "-DCMAKE_BUILD_TYPE=Debug",
      "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
    ],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "never",
    "shell": "system",
    "show_summary": true,
    "show_command": true,
    "save": "none",
  },
  {
    "label": "CMake: Config Release (Clang/Ninja)",
    "command": "cmake",
    "args": [
      "-G",
      "Ninja",
      "-B",
      "build",
      "-S",
      ".",
      "-DCMAKE_CXX_COMPILER=clang++",
      "-DCMAKE_BUILD_TYPE=Release",
      "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
    ],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "never",
    "shell": "system",
    "show_summary": true,
    "show_command": true,
    "save": "none",
  },
